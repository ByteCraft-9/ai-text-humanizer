# Copy to .env.local for local development, or set these in the Vercel project.
# Every one is optional: detection works with no keys at all, because it runs
# locally. Only rewriting needs a provider.

# --- LLM providers, in router priority order (PRD 11.1) ---------------------

# Cerebras — 1,000,000 tokens/day, 5 RPM, no credit card.
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Groq — 200,000 tokens/day, 30 RPM, no credit card. Leads on requests/minute,
# so the router falls back here when Cerebras hits its rate limit.
# https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google AI Studio — ~1,500 requests/day, 10 RPM, no credit card.
# https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Models -----------------------------------------------------------------

# Public Hugging Face repo holding the exported ONNX weights, written by
# training/04_export_onnx.ipynb. Leave blank until you have trained them: the
# app runs in degraded mode and says so in the UI.
MODEL_REPO=

# Optional: pin to a revision instead of tracking main.
MODEL_REVISION=main

# Only needed for a private model repo. Public repos need no token.
HF_TOKEN=

# Seconds detect.py waits on perplexity.py before giving up on the Binoculars
# signal and reporting a degraded score. See api/_lib/remote.py.
PERPLEXITY_TIMEOUT=20
